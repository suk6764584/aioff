[Unit]
Description=AI OFF FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aioff
EnvironmentFile=-/opt/aioff/.env
ExecStart=/opt/aioff/.venv/bin/uvicorn literacy_media_app_3:app --host 0.0.0.0 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
